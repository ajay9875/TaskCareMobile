{
  "expo": {
    "name": "TaskCare360",
    "slug": "TaskCareMobile",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taskcaremobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ajay.taskcare360",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ],
        "NSMotionUsageDescription": "Allow TaskCare 360 to track your steps even when the app is closed."
      }
    },
    "android": {
      "package": "com.ajay.taskcare360",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_HEALTH",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#4e5cdb",
        "foregroundImage": "./assets/images/icon.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "mailto"
          }
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": {
            "scheme": "taskcaremobile",
            "host": "login"
          }
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": {
            "scheme": "taskcaremobile",
            "host": "support"
          }
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": {
            "scheme": "taskcaremobile",
            "host": "dashboard"
          }
        }
      ]
    },
    "plugins": [
      "./plugins/withJdkHome",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/native-splash.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-task-manager",
      "expo-background-fetch",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4e5cdb",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f10f38af-0647-45b5-9870-484ef77bd853"
      },
      "updateDescription": "We removed the function to ensure that an internet connection while we switch one mode to another. Now, you can switch between treadmill and walking mode even without an internet connection. The app will sync the data once the internet connection is restored."
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f10f38af-0647-45b5-9870-484ef77bd853",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000
    }
  }
}
